export ZSH="$HOME/.oh-my-zsh"

plugins=(
  git
  fzf-zsh-plugin
  colored-man-pages
  zsh-syntax-highlighting
  zsh-autosuggestions
  web-search
  copypath
  copyfile
  copybuffer
  jsontools
  zsh-vi-mode
)

source $ZSH/oh-my-zsh.sh

eval "$(starship init zsh)"

alias cat="bat"
alias pods="watch -n 2 kubectl get pods -A"
alias svc="watch -n 2 kubectl get svc -A"
alias hpa="watch -n 2 kubectl get hpa -A"
alias kdesc="kubectl describe"
alias klogs="kubectl logs -f"
alias kget="kubectl get"
alias vim="nvim"
alias grep="rg"
alias rng="ranger"
alias k="kubectl"
alias tf="terraform"
alias tfa="terraform apply"
alias tg="terragrunt"
alias tga="terragrunt apply"
alias ot="tofu"
alias ota="tofu apply"
alias v="nvim"

source /opt/homebrew/etc/profile.d/autojump.sh

# Git editor
export GIT_EDITOR=nvim
export EDITOR=nvim

# Created by `pipx` on 2024-02-26 08:12:17
export PATH="$PATH:/Users/jlparis/.local/bin"

export GPG_TTY=$(tty)

export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

function zvm_after_init() {
  bindkey '^p' autosuggest-accept
}

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"                                       # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" # This loads nvm bash_completion

. "/Users/jlparis/.acme.sh/acme.sh.env"
export PATH="$HOME/go/bin:$PATH"

export TG_LOG_CUSTOM_FORMAT="%prefix(path=short-relative,color=gradient,prefix='[',suffix='] ')%tf-path(path=filename,color=cyan,suffix=': ')%msg"
eval "$(direnv hook zsh)"
