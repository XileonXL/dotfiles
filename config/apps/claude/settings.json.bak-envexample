  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.tf|*.tfvars) cd \"$(dirname \"$f\")\" && terraform fmt . 2>&1 | sed \"s/^/[terraform fmt] /\" ;; esac'"
          },
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.sh|*.bash) shellcheck --severity=warning \"$f\" 2>&1 | sed \"s/^/[shellcheck] /\" ;; esac'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "language": "es",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryEnabled": true
