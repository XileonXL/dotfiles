{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "MAX_MCP_OUTPUT_TOKENS": "20000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(terraform output*)",
      "Bash(terraform init *)",
      "Bash(terraform workspace *)",
      "Bash(terraform providers *)",
      "Bash(terraform version*)",
      "Bash(tofu fmt *)",
      "Bash(tofu validate *)",
      "Bash(tofu plan *)",
      "Bash(tofu show *)",
      "Bash(tofu state list*)",
      "Bash(tofu state show*)",
      "Bash(tofu output*)",
      "Bash(tofu init *)",
      "Bash(tofu workspace *)",
      "Bash(tofu providers *)",
      "Bash(tofu version*)",
      "Bash(terragrunt fmt *)",
      "Bash(terragrunt validate *)",
      "Bash(terragrunt plan *)",
      "Bash(terragrunt show *)",
      "Bash(terragrunt output*)",
      "Bash(terragrunt init *)",
      "Bash(tflint *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl top *)",
      "Bash(kubectl config *)",
      "Bash(kubectl version*)",
      "Bash(kubectl api-resources*)",
      "Bash(kubectl api-versions*)",
      "Bash(helm list *)",
      "Bash(helm status *)",
      "Bash(helm get *)",
      "Bash(helm show *)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(helm diff *)",
      "Bash(helm repo *)",
      "Bash(helm search *)",
      "Bash(helm version*)",
      "Bash(helmfile list *)",
      "Bash(helmfile status *)",
      "Bash(helmfile template *)",
      "Bash(helmfile diff *)",
      "Bash(helmfile lint *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(uv *)",
      "Bash(pre-commit *)",
      "Bash(shellcheck *)",
      "Bash(trivy *)",
      "Bash(yq *)",
      "Bash(jq *)",
      "Bash(stow *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod +x *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(sed *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -f *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(git clean -f*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform force-unlock*)",
      "Bash(terraform import*)",
      "Bash(terraform taint*)",
      "Bash(terraform untaint*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(tofu force-unlock*)",
      "Bash(tofu import*)",
      "Bash(terragrunt apply*)",
      "Bash(terragrunt destroy*)",
      "Bash(terragrunt run-all apply*)",
      "Bash(terragrunt run-all destroy*)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl taint *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl scale *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm rollback *)",
      "Bash(helmfile apply *)",
      "Bash(helmfile sync *)",
      "Bash(helmfile destroy *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.cert)",
      "Read(**/*_token)",
      "Read(**/*.token)",
      "Read(**/*-token.json)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.cert)",
      "Write(**/pnpm-lock.yaml)",
      "Write(**/package-lock.json)",
      "Write(**/yarn.lock)",
      "Write(**/bun.lockb)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(*/.env)",
      "Edit(*/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.cert)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Edit(**/bun.lockb)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"${CLAUDE_TOOL_INPUT_FILE_PATH:-${CLAUDE_TOOL_INPUT_PATH:-}}\"; case \"$f\" in *.tf|*.tfvars) cd \"$(dirname \"$f\")\" && terraform fmt . 2>&1 | sed \"s/^/[terraform fmt] /\" ;; esac'"
          },
          {
            "type": "command",
            "command": "bash -c 'f=\"${CLAUDE_TOOL_INPUT_FILE_PATH:-${CLAUDE_TOOL_INPUT_PATH:-}}\"; case \"$f\" in *.sh|*.bash) shellcheck --severity=warning \"$f\" 2>&1 | sed \"s/^/[shellcheck] /\" ;; esac'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {},
  "language": "es",
  "alwaysThinkingEnabled": false
}
