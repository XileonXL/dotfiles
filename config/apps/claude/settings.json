      "Bash(tofu apply:*) in /Users/jlparis/personal/subastas-boe/infra",
      "Bash(tofu destroy:*) in /Users/jlparis/personal/subastas-boe/infra",
      "Bash(aws s3 rm:*) targeting bidsenseai-pro-documents"
    ],
