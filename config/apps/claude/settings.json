  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.tf|*.tfvars) cd \"$(dirname \"$f\")\" && terraform fmt . 2>&1 | sed \"s/^/[terraform fmt] /\" ;; esac'"
          },
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.sh|*.bash) shellcheck --severity=warning \"$f\" 2>&1 | sed \"s/^/[shellcheck] /\" ;; esac'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "es",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv run *) in /Users/jlparis/personal/subastas-boe",
      "Bash(tofu plan:*) in /Users/jlparis/personal/subastas-boe/infra",
      "Bash(tofu validate:*) in /Users/jlparis/personal/subastas-boe/infra",
