  "model": "fable",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true
  },
  "language": "es",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "switchModelsOnFlag": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Read-only infrastructure commands are allowed in any repository: tofu, terraform and terragrunt plan, validate, fmt and show; tflint, shellcheck, ansible-lint, and ansible-playbook with --check or --syntax-check",
      "Running the current repository's own linters, type checkers and tests through uv run is allowed"
    ],
    "soft_deny": [
      "$defaults",
      "Running tofu, terraform or terragrunt apply, destroy or import needs an explicit request in the current conversation: the user reads the plan and decides",
      "Mutating a Kubernetes cluster (kubectl apply, delete or patch; helm install, upgrade, uninstall or rollback; helmfile apply, sync or destroy) needs an explicit request in the current conversation",
      "Running ansible-playbook without --check or --syntax-check needs an explicit request in the current conversation: it changes real machines"
    ],
    "environment": [
      "**Organization**: None configured. One engineer using this machine for both personal and work repositories",
      "**Primary use of Claude Code**: software development and infrastructure automation (Terraform/OpenTofu/Terragrunt, Kubernetes/Helm, Ansible, CI/CD, Python and Bash tooling)",
      "**Trusted repo**: the repository of the current working directory, including its git worktrees",
      "**Source control**: the remotes already configured in the current repository. Any other remote is outside the trust boundary",
      "**Repository visibility**: some personal repositories are public. Assume anything committed may be published: no secrets and no site-specific details in tracked files",
      "**Cloud provider(s)**: AWS, through named CLI profiles. The active profile decides the account",
      "**Secrets management**: AWS Secrets Manager and SSM Parameter Store. Local .env files are git-ignored and never committed",
      "**Internal sharing / snippet hosting**: None configured. Public paste and gist services are outside the trust boundary",
      "**Host containment**: None configured. Ordinary developer laptop with open internet",
      "**Org-specific CLIs**: tofu, terraform, terragrunt, aws, kubectl, helm, helmfile, ansible-playbook, uv",
      "**Sensitive remote targets**: any cloud resource, cluster, namespace or host named with pro, prod or production as a whole segment",
      "**Protected IaC scopes**: every Terraform/OpenTofu/Terragrunt state and every Ansible inventory. Planning and linting are routine; applying is the user's decision",
      "**Sensitive data locations & audiences**: .env and .envrc files, Terraform/OpenTofu state files, SSH and GPG keys, cloud credentials. Never shared outside the machine"
    ]
  }
}
