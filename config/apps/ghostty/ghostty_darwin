font-family = "UbuntuMono Nerd Font"
# font-family = "Hack Nerd Font Mono"
# font-family = "FiraCode Nerd Font Mono"
# font-family = "JetBrainsMono Nerd Font"
# font-family = "Iosevka Nerd Font Mono"
font-size = 22

background-opacity = 0.85
background-blur-radius = 20

window-decoration = false

command = /opt/homebrew/bin/tmux new-session -A -s main

palette = 0=#1d3b53
palette = 1=#fc514e
palette = 2=#a1cd5e
palette = 3=#e3d18a
palette = 4=#82aaff
palette = 5=#c792ea
palette = 6=#7fdbca
palette = 7=#a1aab8
palette = 8=#7c8f8f
palette = 9=#ff5874
palette = 10=#21c7a8
palette = 11=#ecc48d
palette = 12=#82aaff
palette = 13=#ae81ff
palette = 14=#7fdbca
palette = 15=#d6deeb

background = #011627
foreground = #bdc1c6
cursor-color = #9ca1aa
cursor-text = #080808
selection-background = #b2ceee
selection-foreground = #080808

keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
